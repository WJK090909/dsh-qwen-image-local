{
  "name": "dsh-qwen-image-local",
  "version": "0.3.1",
  "private": true,
  "description": "Generate images with a local Qwen Image service from DSH",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "tests/*.test.js", "scripts/*.ps1"],
  "engines": { "node": ">=20", "dsh": "0.2.2-rc.1" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1"
  },
  "icon": "./icon.svg",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
